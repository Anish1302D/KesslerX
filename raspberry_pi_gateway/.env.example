# KesslerX Raspberry Pi Zero W Ground Station Gateway Environment
# Copy to protected system config: /etc/kesslerx/ground-station.env (chmod 600)

GROUND_STATION_ID=KX-RPI-ZERO-GS-001
HARDWARE_MODEL=Raspberry Pi Zero W

# Target KesslerX Backend (Render Production)
KESSLERX_BACKEND_URL=https://kesslerx-backend.onrender.com

# Local LAN Binding (HTTP + WS on 8765, optional TLS HTTPS + WSS on 8443 for phone sensors)
RPI_HOST=0.0.0.0
RPI_PORT=8765
RPI_HTTPS_PORT=8443

# Resource-Constrained Pi Zero W Limits (armv6l, 426 MiB RAM)
MAX_MEMORY_QUEUE=100
MAX_SQLITE_ROWS=5000
SQLITE_DB_PATH=/home/anish/kesslerx-ground-station/data/telemetry_buffer.db

TELEMETRY_RATE_HZ=2
FORWARD_BATCH_SIZE=10
HTTP_TIMEOUT_SECONDS=10
MAX_RETRY_SECONDS=60
HEALTH_CACHE_SECONDS=10
LOG_LEVEL=INFO
