# ============================================================
# KesslerX Environment Variables Reference
# Copy this file to .env for local development
# ============================================================

# --- Frontend Configuration ---
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- Backend Configuration ---
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,https://kessler-x.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://kessler-x.vercel.app

# Upstream Orbital Data
SPACE_TRACK_USERNAME=your_space_track_username
SPACE_TRACK_PASSWORD=your_space_track_password

# AI & LLM Decision Support
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (Backend Persistence & Token Verification)
FIREBASE_PROJECT_ID=your_project_id
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON string) or FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
