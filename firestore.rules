rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isSafetyLeadOrAdmin() {
      return isSignedIn() && (
        hasRole('administrator') ||
        hasRole('mission operations lead') ||
        hasRole('safety analyst') ||
        hasRole('mission manager')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId) || hasRole('administrator');
      allow delete: if hasRole('administrator');
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if hasRole('administrator');
    }

    // Conjunction Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSafetyLeadOrAdmin() || (isSignedIn() && resource.data.current_owner_id == request.auth.uid);
      allow delete: if hasRole('administrator');

      // Subcollection: Event Handoffs
      match /handoffs/{handoffId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSafetyLeadOrAdmin() ||
                         (isSignedIn() && (resource.data.from_user_id == request.auth.uid || resource.data.to_user_id == request.auth.uid));
        allow delete: if hasRole('administrator');
      }

      // Subcollection: Event Timeline
      match /timeline/{entryId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false; // Append-only immutable log
      }
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSafetyLeadOrAdmin();
      allow delete: if hasRole('administrator') || hasRole('mission manager');
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSafetyLeadOrAdmin();
      allow update: if isSignedIn(); // e.g. acknowledge
      allow delete: if hasRole('administrator');
    }

    // Audit logs (Immutable)
    match /audit/{auditId} {
      allow read: if isSafetyLeadOrAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Audit logs can never be mutated or deleted
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
